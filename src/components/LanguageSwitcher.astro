---
import { LOCALES } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<select id="lang-switcher" class="input h-8 px-2 text-xs" aria-label="Language">
  {
    LOCALES.map((l) => (
      <option value={l.code} selected={l.code === locale}>
        {l.label}
      </option>
    ))
  }
</select>

<script>
  const select = document.getElementById('lang-switcher') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    const target = select.value;
    const { pathname, search, hash } = location;
    const stripped = pathname.replace(/^\/(zh-TW|en|ja)(?=\/|$)/, '') || '/';
    location.href = (target === 'zh-CN' ? stripped : `/${target}${stripped}`) + search + hash;
  });
</script>
