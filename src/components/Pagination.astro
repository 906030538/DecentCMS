---
import { t } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav class="flex items-center justify-center gap-3 py-4" data-component="pagination">
  <button type="button" class="btn" data-action="prev" disabled>
    ← {t(locale, 'common.prevPage')}
  </button>
  <span class="text-sm text-slate-500 dark:text-slate-400" data-role="page-info">1 / 1</span>
  <button type="button" class="btn" data-action="next" disabled>
    {t(locale, 'common.nextPage')} →
  </button>
</nav>
