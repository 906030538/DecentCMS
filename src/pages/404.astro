---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, normalizeLocale } from '@/i18n';
import { SITE_NAME } from '@/config';

const locale = normalizeLocale(Astro.currentLocale);
---

<BaseLayout title="404">
  <div class="py-24 text-center">
    <p class="text-6xl font-bold text-slate-200 dark:text-slate-800">404</p>
    <a href={localePath(locale, '/')} class="btn btn-primary mt-6">
      ← {SITE_NAME}
    </a>
  </div>
</BaseLayout>
