---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FilterBar from '@/components/FilterBar.astro';
import LoadingBlock from '@/components/LoadingBlock.astro';
import Pagination from '@/components/Pagination.astro';
import { PAGE_SIZE } from '@/config';
import { normalizeLocale, t } from '@/i18n';

const locale = normalizeLocale(Astro.currentLocale);
---

<BaseLayout title={t(locale, 'project.title')}>
  <h1 class="mb-6 text-2xl font-bold">{t(locale, 'project.title')}</h1>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <FilterBar locale={locale} />
    <div class="ml-auto flex items-center gap-2">
      <input
        type="search"
        class="input w-56"
        data-role="search-input"
        placeholder={t(locale, 'project.searchPlaceholder')}
      />
      <button type="button" class="btn btn-primary" data-action="search">
        {t(locale, 'common.search')}
      </button>
    </div>
  </div>

  <div class="flex flex-col gap-3" data-component="list"></div>
  <p class="py-8 text-center text-slate-400" data-role="empty" hidden>
    {t(locale, 'common.noResults')}
  </p>
  <LoadingBlock locale={locale} />
  <Pagination locale={locale} />

  <script is:inline type="application/json" id="list-labels" set:html={JSON.stringify({
    paramsWith: t(locale, 'params.with'),
    paramsTuned: t(locale, 'params.tuned'),
    paramsNone: t(locale, 'params.none'),
    all: t(locale, 'common.all'),
  })} />
  <script is:inline type="application/json" id="list-config" set:html={JSON.stringify({ pageSize: PAGE_SIZE })} />

  <script>
    import { applyFilters, loadMockIndex } from '@/lib/index/loader';
    import { renderCard, type CardLabels } from '@/lib/ui';
    import type { FilterState, SubmissionEntry } from '@/types';

    const locale = document.documentElement.lang;
    const labels = JSON.parse(
      document.getElementById('list-labels')!.textContent!,
    ) as CardLabels;
    const config = JSON.parse(
      document.getElementById('list-config')!.textContent!,
    ) as { pageSize: number };

    const listEl = document.querySelector('[data-component="list"]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-role="empty"]')!;
    const loadingEl = document.querySelector<HTMLElement>('[data-component="loading"]')!;
    const pageInfo = document.querySelector<HTMLElement>('[data-role="page-info"]')!;
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-action="prev"]')!;
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const cancelBtn = document.querySelector<HTMLButtonElement>('[data-action="cancel"]')!;
    const searchInput = document.querySelector<HTMLInputElement>('[data-role="search-input"]')!;
    const searchBtn = document.querySelector<HTMLButtonElement>('[data-action="search"]')!;
    const filterSelects = [
      ...document.querySelectorAll<HTMLSelectElement>('[data-component="filters"] select'),
    ];

    let entries: SubmissionEntry[] = [];
    let filtered: SubmissionEntry[] = [];
    let page = 0;
    let keyword = '';
    let aborter: AbortController | null = null;

    function getFilters(): FilterState {
      const filters: FilterState = {};
      for (const select of filterSelects) {
        if (select.value) {
          filters[select.dataset.filter as keyof FilterState] = select.value;
        }
      }
      return filters;
    }

    function populateFilterOptions(): void {
      const collect = (pick: (e: SubmissionEntry) => string[] | undefined) =>
        [...new Set(entries.flatMap((e) => pick(e) ?? []))].sort();
      const sources: Record<string, string[]> = {
        track: collect((e) => e.tracks),
        engine: collect((e) => e.engines),
        voicebank: collect((e) => e.voicebanks),
        songLanguage: collect((e) => e.songLanguages),
      };
      for (const select of filterSelects) {
        const key = select.dataset.filter as keyof typeof sources;
        for (const value of sources[key]) {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = value;
          select.appendChild(option);
        }
      }
    }

    function applyAndRender(): void {
      filtered = applyFilters(entries, getFilters());
      if (keyword) {
        const kw = keyword.toLowerCase();
        filtered = filtered.filter((e) =>
          [e.title, e.user, ...(e.tracks ?? []), ...(e.tags ?? [])]
            .join(' ')
            .toLowerCase()
            .includes(kw),
        );
      }
      page = 0;
      renderPage();
    }

    function renderPage(): void {
      const totalPages = Math.max(1, Math.ceil(filtered.length / config.pageSize));
      page = Math.min(page, totalPages - 1);
      const slice = filtered.slice(page * config.pageSize, (page + 1) * config.pageSize);

      listEl.textContent = '';
      for (const entry of slice) listEl.appendChild(renderCard(entry, locale, labels));
      emptyEl.hidden = slice.length > 0;
      pageInfo.textContent = `${page + 1} / ${totalPages}`;
      prevBtn.disabled = page === 0;
      nextBtn.disabled = page >= totalPages - 1;
    }

    prevBtn.addEventListener('click', () => {
      page -= 1;
      renderPage();
    });
    nextBtn.addEventListener('click', () => {
      page += 1;
      renderPage();
    });
    for (const select of filterSelects) select.addEventListener('change', applyAndRender);
    searchBtn.addEventListener('click', () => {
      keyword = searchInput.value.trim();
      applyAndRender();
    });
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') searchBtn.click();
    });
    cancelBtn.addEventListener('click', () => aborter?.abort());

    // 初始加载（真实实现：先未归档索引，耗尽后按页自动加载归档索引，期间显示加载与取消）
    loadingEl.hidden = false;
    aborter = new AbortController();
    try {
      const index = await loadMockIndex();
      entries = index.submissions
        .filter((e) => e.type === 'project')
        .sort((a, b) => b.date.localeCompare(a.date));
      populateFilterOptions();
      applyAndRender();
    } catch {
      emptyEl.hidden = false;
    } finally {
      loadingEl.hidden = true;
    }
  </script>
</BaseLayout>
