---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildEditorLabels, buildLicenseOptions } from '@/lib/editor/labels';
import { normalizeLocale, t } from '@/i18n';

const locale = normalizeLocale(Astro.currentLocale);

const editorConfig = {
  mode: 'new',
  licenseOptions: buildLicenseOptions(locale),
};
const editorLabels = buildEditorLabels(locale);
---

<BaseLayout title={t(locale, 'new.title')}>
  <h1 class="mb-6 text-2xl font-bold">{t(locale, 'new.title')}</h1>

  <div data-role="editor-root"></div>

  <script is:inline type="application/json" id="editor-config" set:html={JSON.stringify(editorConfig)} />
  <script is:inline type="application/json" id="editor-labels" set:html={JSON.stringify(editorLabels)} />

  <script>
    import { initEditor, type EditorConfig, type EditorLabels } from '@/lib/views/editor';

    try {
      const config = JSON.parse(
        document.getElementById('editor-config')!.textContent!,
      ) as EditorConfig;
      const labels = JSON.parse(
        document.getElementById('editor-labels')!.textContent!,
      ) as EditorLabels;
      await initEditor(config, labels, document.querySelector('[data-role="editor-root"]')!);
    } catch (error) {
      console.error('[editor] init failed:', error);
    }
  </script>
</BaseLayout>
