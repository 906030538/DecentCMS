---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { normalizeLocale, t } from '@/i18n';
import { userStaticPaths } from '@/lib/paths';

const locale = normalizeLocale(Astro.currentLocale);

/**
 * 动态路由 /user/:name。
 * 演示期基于本地索引为每个用户生成静态页；
 * 接入真实索引仓后需为任意用户名配置 SPA 回退或改用 SSR 适配器。
 */
export function getStaticPaths() {
  return userStaticPaths();
}

const name = Astro.params.name ?? '';

const labels = {
  space: t(locale, 'user.title'),
  projects: t(locale, 'user.projects'),
  articles: t(locale, 'user.articles'),
  more: t(locale, 'user.more'),
  newCollection: t(locale, 'user.newCollection'),
  site: t(locale, 'user.site'),
  about: t(locale, 'user.about'),
  noRepos: t(locale, 'user.noRepos'),
  prefix: t(locale, 'user.prefix'),
  repoName: t(locale, 'user.repoName'),
  owner: t(locale, 'user.owner'),
  template: t(locale, 'user.template'),
  license: t(locale, 'user.license'),
  licenseDefault: t(locale, 'editor.licenseRepoDefault'),
  create: t(locale, 'user.create'),
  cancel: t(locale, 'common.cancel'),
  created: t(locale, 'user.created'),
  createFailed: t(locale, 'user.createFailed'),
  nameRequired: t(locale, 'user.nameRequired'),
};
---

<BaseLayout title={`${name} · ${t(locale, 'user.title')}`}>
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <div
      data-role="avatar"
      class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-200 text-2xl font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400"
    >
      {name.charAt(0).toUpperCase()}
    </div>
    <div>
      <h1 class="text-2xl font-bold">{name}</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">{t(locale, 'user.title')}</p>
    </div>
    <div class="ml-auto flex flex-wrap items-center gap-2">
      <span data-role="site" class="flex gap-2"></span>
      <span data-role="actions" class="flex gap-2"></span>
    </div>
  </div>

  <div class="mb-6 flex gap-2" data-role="platforms"></div>

  <section class="mb-8 hidden" data-role="about">
    <h2 class="mb-3 border-l-4 border-indigo-600 pl-3 text-xl font-semibold">
      {t(locale, 'user.about')}
    </h2>
    <div class="card prose-svp p-5" data-role="about-body"></div>
  </section>

  <section>
    <h2 class="mb-4 border-l-4 border-indigo-600 pl-3 text-xl font-semibold">
      {t(locale, 'user.projects')}
    </h2>
    <div class="flex flex-col gap-6" data-component="project-collections"></div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4 border-l-4 border-indigo-600 pl-3 text-xl font-semibold">
      {t(locale, 'user.articles')}
    </h2>
    <div class="flex flex-col gap-6" data-component="article-collections"></div>
  </section>

  <script is:inline type="application/json" id="user-config" set:html={JSON.stringify({ name })} />
  <script is:inline type="application/json" id="user-labels" set:html={JSON.stringify(labels)} />

  <script>
    import { initUser, type UserLabels } from '@/lib/views/user';

    const config = JSON.parse(
      document.getElementById('user-config')!.textContent!,
    ) as { name: string };
    const labels = JSON.parse(
      document.getElementById('user-labels')!.textContent!,
    ) as UserLabels;

    try {
      await initUser({
        name: config.name,
        locale: document.documentElement.lang,
        labels,
        els: {
          avatar: document.querySelector('[data-role="avatar"]')!,
          site: document.querySelector('[data-role="site"]')!,
          platforms: document.querySelector('[data-role="platforms"]')!,
          actions: document.querySelector('[data-role="actions"]')!,
          about: document.querySelector<HTMLElement>('[data-role="about"]')!,
          aboutBody: document.querySelector('[data-role="about-body"]')!,
          projectCollections: document.querySelector('[data-component="project-collections"]')!,
          articleCollections: document.querySelector('[data-component="article-collections"]')!,
        },
      });
    } catch (error) {
      console.error('[user] init failed:', error);
    }
  </script>
</BaseLayout>
