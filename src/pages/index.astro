---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_NAME } from '@/config';
import { localePath, t } from '@/i18n';
import { normalizeLocale } from '@/i18n';

const locale = normalizeLocale(Astro.currentLocale);
---

<BaseLayout>
  <section class="py-12 text-center">
    <h1 class="text-4xl font-bold tracking-tight">
      {SITE_NAME}
    </h1>
    <p class="mt-3 text-lg text-slate-500 dark:text-slate-400">{t(locale, 'home.hero')}</p>
    <p class="mt-2 text-sm text-slate-400 dark:text-slate-500">{t(locale, 'home.tagline')}</p>
    <p class="mx-auto mt-6 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">
      {t(locale, 'home.intro')}
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href={localePath(locale, '/project')} class="btn btn-primary">
        {t(locale, 'nav.projects')}
      </a>
      <a href={localePath(locale, '/about')} class="btn">{t(locale, 'nav.about')}</a>
    </div>
  </section>

  <section class="mx-auto grid max-w-3xl grid-cols-2 gap-4 text-center">
    <div class="card p-6">
      <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400" data-stat="submissions">
        –
      </div>
      <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        {t(locale, 'home.submissionCount')}
      </div>
    </div>
    <div class="card p-6">
      <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400" data-stat="users">–</div>
      <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">{t(locale, 'home.userCount')}</div>
    </div>
  </section>

  <section class="mt-12">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">{t(locale, 'home.latest')}</h2>
      <a
        href={localePath(locale, '/project')}
        class="text-sm text-indigo-600 hover:underline dark:text-indigo-400"
      >
        {t(locale, 'home.viewAll')} →
      </a>
    </div>
    <div class="flex flex-col gap-3" data-component="latest-list"></div>
  </section>

  <script is:inline type="application/json" id="home-labels" set:html={JSON.stringify({
    paramsWith: t(locale, 'params.with'),
    paramsTuned: t(locale, 'params.tuned'),
    paramsNone: t(locale, 'params.none'),
  })} />

  <script>
    import { loadMockIndex } from '@/lib/index/loader';
    import { renderCard, type CardLabels } from '@/lib/ui';

    const locale = document.documentElement.lang;
    const labels = JSON.parse(
      document.getElementById('home-labels')!.textContent!,
    ) as CardLabels;

    try {
      const index = await loadMockIndex();

      const submissions = document.querySelector('[data-stat="submissions"]');
      if (submissions) submissions.textContent = String(index.submissions.length);
      const users = document.querySelector('[data-stat="users"]');
      if (users) users.textContent = String(new Set(index.submissions.map((s) => s.user)).size);

      const list = document.querySelector('[data-component="latest-list"]');
      if (list) {
        const latest = [...index.submissions]
          .sort((a, b) => b.date.localeCompare(a.date))
          .slice(0, 5);
        for (const entry of latest) list.appendChild(renderCard(entry, locale, labels));
      }
    } catch {
      /* 索引加载失败时保留静态壳 */
    }
  </script>
</BaseLayout>
