---
import PageRaw from '@/pages/view/[...path].astro';
import mockIndex from '../../../../public/mock/index.json';
const Page = PageRaw as any;

export function getStaticPaths() {
  const paths = new Set<string>();
  for (const user of mockIndex.users) paths.add(`${user.user}/${user.repo}`);
  for (const sub of mockIndex.submissions) paths.add(`${sub.user}/${sub.repo}/${sub.slug}`);
  return Array.from(paths).map((path) => ({ params: { path } }));
}
---

<Page />
